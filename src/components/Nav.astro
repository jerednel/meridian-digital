---
import { NAV_LINKS } from '../lib/site';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  const clean = href.replace(/\/$/, '') || '/';
  if (clean === '/') return currentPath === '/';
  return currentPath === clean || currentPath.startsWith(clean + '/');
}
---

<header class="fixed top-0 inset-x-0 z-50 border-b border-transparent bg-dark/95 text-on-dark backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-5">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label="Meridian home">
      <img
        src="/logos/logo-dark-white.jpg"
        alt="Meridian Digital"
        width="180"
        height="36"
        class="h-8 w-auto"
        style="mix-blend-mode: screen;"
      />
    </a>

    <nav aria-label="Primary" class="hidden md:flex items-center gap-7">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'text-sm tracking-wide transition-colors',
            isActive(link.href) ? 'text-on-dark' : 'text-on-dark-muted hover:text-on-dark',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/#missing"
        class="btn btn-primary"
        data-track="cta_see_where_click"
        data-location="nav"
      >
        See where you're missing
      </a>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="md:hidden inline-flex h-10 w-10 items-center justify-center border border-white/20"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <span class="sr-only">Menu</span>
      <span class="flex flex-col gap-1.5" aria-hidden="true">
        <span class="block h-px w-5 bg-on-dark" id="bar1"></span>
        <span class="block h-px w-5 bg-on-dark" id="bar2"></span>
        <span class="block h-px w-5 bg-on-dark" id="bar3"></span>
      </span>
    </button>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-white/10 bg-dark" hidden>
    <nav aria-label="Mobile" class="flex flex-col gap-1 px-5 py-4">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class:list={[
            'py-3 text-sm',
            isActive(link.href) ? 'text-on-dark' : 'text-on-dark-muted',
          ]}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/#missing"
        class="btn btn-primary mt-2"
        data-track="cta_see_where_click"
        data-location="nav-mobile"
      >
        See where you're missing
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.hasAttribute('hidden');
      menu.toggleAttribute('hidden', !open);
      menu.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const link = target?.closest<HTMLElement>('[data-track]');
    if (!link) return;
    const name = link.dataset.track;
    const location = link.dataset.location || 'unknown';
    const gtag = (window as Window & { gtag?: (...args: unknown[]) => void }).gtag;
    if (name && typeof gtag === 'function') {
      gtag('event', name, { location });
    }
  });
</script>
