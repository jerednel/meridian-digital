---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout
  title="We got it — Meridian"
  description="Your inquiry was received."
  noindex
>
  <section class="bg-paper pt-32 pb-24">
    <div class="mx-auto max-w-3xl px-5">
      <p class="eyebrow">Received</p>
      <h1 class="mt-4 font-display text-4xl md:text-5xl">We'll look at the questions buyers ask in your category.</h1>
      <p class="mt-5 text-lg text-ink-soft leading-relaxed">
        If there isn't a meaningful gap, that's the reply. Otherwise we'll come back with competitive findings — not a generic audit.
      </p>
      <a href="/" class="btn btn-primary mt-8">Back to Meridian</a>
    </div>
  </section>
</Layout>
