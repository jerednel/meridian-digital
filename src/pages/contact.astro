---
import Layout from '../layouts/Layout.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE } from '../lib/site';
import { graph, organizationSchema } from '../lib/schema';

export const prerender = true;

const schema = graph([organizationSchema()]);
---

<Layout
  title="Contact — Meridian"
  description="Send a company website and work email. Meridian will look at buyer questions in your category and reply with what we find."
  structuredData={schema}
>
  <header class="bg-dark text-on-dark pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="mx-auto max-w-6xl px-5">
      <p class="eyebrow eyebrow-dark">Contact</p>
      <h1 class="mt-5 max-w-3xl font-display text-4xl leading-[1.05] md:text-6xl">
        See where you're missing.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-on-dark-muted">
        Company website and work email. Optional name. We'll come back with competitive findings for your category — or tell you there isn't a meaningful opportunity. Prefer email? {SITE.email}.
      </p>
    </div>
  </header>

  <section class="bg-paper py-20">
    <div class="mx-auto max-w-xl px-5">
      <LeadForm source="contact" variant="light" id="contact-lead" />
    </div>
  </section>
</Layout>
