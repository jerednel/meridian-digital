---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { graph, organizationSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

export const prerender = true;

const posts = (await getCollection('insights')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const schema = graph([organizationSchema()]);
---

<Layout
  title="Insights — Meridian"
  description="Notes on buyer research, shortlists, and visibility across Google and AI search — from Meridian."
  structuredData={schema}
>
  <header class="bg-dark text-on-dark pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="mx-auto max-w-6xl px-5">
      <p class="eyebrow eyebrow-dark">From {SITE.name}</p>
      <h1 class="mt-5 font-display text-4xl md:text-6xl">Insights</h1>
      <p class="mt-6 max-w-2xl text-lg text-on-dark-muted leading-relaxed">
        On the research that happens before a vendor website is opened.
      </p>
    </div>
  </header>

  <section class="bg-paper py-16 md:py-24">
    <div class="mx-auto max-w-6xl px-5">
      <ul class="divide-y divide-rule border-y border-rule">
        {posts.map((post) => (
          <li>
            <a href={`/insights/${post.id}`} class="grid gap-3 py-10 md:grid-cols-[10rem_1fr] md:gap-10 group">
              <time class="font-mono text-xs uppercase tracking-widest text-muted" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
              <div>
                <h2 class="font-display text-2xl md:text-3xl group-hover:text-accent">{post.data.title}</h2>
                <p class="mt-3 max-w-2xl text-ink-soft leading-relaxed">{post.data.description}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
